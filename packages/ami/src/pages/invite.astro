---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InviteForm from '../components/InviteForm.astro';
import { SITE } from '../config';

const scarcity = [
  `${SITE.seatsTotal} seats, one per enterprise`,
  SITE.seatsRemaining != null ? `${SITE.seatsRemaining} seats remain` : '',
  SITE.inviteDeadline ? `Invitations close ${SITE.inviteDeadline}` : '',
].filter(Boolean);
---
<Base
  title="Your invitation | Agent Maturity Index"
  description="Accept your invitation to the Agent Maturity Index Founding Cohort."
  path="/invite"
  noindex
>
  <Header cta={false} />
  <main id="main">
    <section class="intro">
      <div class="wrap intro-grid">
        <div>
          <h1>You’re invited to the Founding Cohort.</h1>
          <p class="lead">Thirty enterprise AI leaders will set the benchmark for how companies run AI agents. We’d like you to be one of them.</p>
          <ul class="scarce" aria-label="Seats">
            {scarcity.map((s) => <li>{s}</li>)}
          </ul>
        </div>
        <aside class="seat" aria-labelledby="seat-h">
          <h2 id="seat-h">Your seat includes</h2>
          <ul>
            <li><strong>A private benchmark</strong> of your agent program on seven dimensions, against the cohort</li>
            <li><strong>A leadership alignment report</strong> showing where your team agrees and where it doesn’t</li>
            <li><strong>The full report</strong> before it is published</li>
          </ul>
          <p class="seat-give">You give one 45-minute research interview.</p>
        </aside>
      </div>
    </section>

    <section class="form-wrap" aria-label="Accept the invitation">
      <div class="wrap narrow">
        <InviteForm />
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .intro { padding: clamp(40px, 7vw, 88px) 0 clamp(48px, 7vw, 80px); }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  h1 { font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1.03; font-weight: 700; letter-spacing: -.04em; }
  .lead { font-size: clamp(1.1rem, 1.6vw, 1.3rem); line-height: 1.5; color: var(--slate); margin: 22px 0 28px; max-width: 28em; }
  .scarce { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .scarce li { display: inline-flex; align-items: center; gap: 8px; min-height: 36px; padding: 0 14px; border-radius: 999px; border: 1.5px solid var(--accent); color: var(--accent-ink); font-size: 14px; font-weight: 600; }
  .scarce li:first-child::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }

  .seat { background: var(--mist); border-radius: 20px; padding: clamp(22px, 3vw, 32px); }
  .seat h2 { font-size: 1.25rem; letter-spacing: -.015em; margin-bottom: 14px; }
  .seat ul { margin: 0; padding-left: 1.1em; }
  .seat li { margin: 10px 0; color: var(--slate); }
  .seat li strong { color: var(--ink); font-weight: 600; }
  .seat li::marker { color: var(--accent); }
  .seat-give { margin: 18px 0 0; padding-top: 16px; border-top: 1px solid var(--line); font-weight: 600; }

  .form-wrap { background: var(--mist); padding: clamp(40px, 6vw, 80px) 0 clamp(64px, 9vw, 112px); }
  .narrow { max-width: 880px; }

  @media (max-width: 860px) {
    .intro-grid { grid-template-columns: 1fr; }
    .intro { padding-top: 24px; }
  }
</style>
