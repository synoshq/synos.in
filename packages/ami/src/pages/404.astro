---
import { BASE } from '../config';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
---
<Base title="Page not found | Agent Maturity Index" description="This page does not exist. Go to the Agent Maturity Index home page." path="/404" noindex>
  <Header />
  <main id="main" class="wrap nf">
    <h1>This page does not exist.</h1>
    <p class="muted">The link may be old or mistyped.</p>
    <a class="btn btn-primary" href={BASE}>Go to the Agent Maturity Index</a>
  </main>
</Base>
<style>
  .nf { min-height: 70vh; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 8px; }
  .nf h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); letter-spacing: -.035em; }
  .nf .btn { margin-top: 20px; }
</style>
