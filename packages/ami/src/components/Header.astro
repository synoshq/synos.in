---
import { BASE, SITE } from '../config';
interface Props { cta?: boolean }
const { cta = true } = Astro.props;
---
<header class="top" data-top>
  <div class="wrap top-in">
    <div class="brand">
      <a class="synos" href={SITE.publisherUrl} aria-label="SynOS home">
        <svg width="22" height="22" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M11 7C11 7 11 7 16 7C21 7 23 10 23 13C23 16 21 18 16 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M21 25C21 25 21 25 16 25C11 25 9 22 9 19C9 16 11 14 16 14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        <span>SynOS</span>
      </a>
    </div>
    <nav class="top-nav" aria-label="Main">
      <div class="theme" role="group" aria-label="Colour theme">
        <button type="button" data-theme-set="light" aria-pressed="true" title="Light mode">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></g></svg>
          <span class="sr-only">Light</span>
        </button>
        <button type="button" data-theme-set="dark" aria-pressed="false" title="Dark mode">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
          <span class="sr-only">Dark</span>
        </button>
      </div>
      {cta && <a class="top-cta" href={`${BASE}#join`} data-intent="cohort" data-cta="topnav" tabindex="-1" aria-hidden="true">Apply</a>}
    </nav>
  </div>
</header>

<style>
  .top { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: var(--paper); border-bottom: 1px solid transparent; transition: border-color .2s, background-color .2s; }
  .top.is-stuck { border-bottom-color: var(--line); }
  .top-in { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 60px; }
  .brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .synos { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--ink); text-decoration: none; font-weight: 650; font-size: 17px; letter-spacing: -.01em; }
  .synos svg { color: var(--accent); flex: none; }
  .top-nav { display: flex; align-items: center; gap: 4px; }
  .top-nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; font-size: 15px; font-weight: 500; color: var(--slate); text-decoration: none; }
  .top-nav a:hover { color: var(--ink); }
  .top-nav .top-cta { font-weight: 600; color: var(--on-accent); background: var(--accent); border-radius: 999px; min-height: 36px; padding: 0 16px; margin-left: 6px; opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity .2s, transform .2s, visibility .2s, background-color .15s; }
  .top-nav .top-cta:hover { color: var(--on-accent); background: var(--accent-ink); }
  .top.is-stuck .top-cta { opacity: 1; visibility: visible; transform: none; }
  .top:not(.is-stuck) .top-cta { position: absolute; pointer-events: none; }
  .theme { display: inline-flex; padding: 3px; gap: 2px; border: 1px solid var(--line); border-radius: 999px; }
  .theme button { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 30px; padding: 0; border: 0; border-radius: 999px; background: none; color: var(--slate); cursor: pointer; transition: background-color .15s, color .15s; }
  .theme button:hover { color: var(--ink); }
  .theme button[aria-pressed="true"] { background: var(--mist); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
  .theme button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>

<script>
  // Light/dark toggle. Starts from the device setting; a click pins the other
  // theme on <html data-theme> and remembers it for the next visit.
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.top [data-theme-set]')];
  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: dark)');
  const current = () => root.dataset.theme || (media.matches ? 'dark' : 'light');
  const sync = () => { const t = current(); btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === t))); };
  btns.forEach((b) => b.addEventListener('click', () => {
    const next = b.dataset.themeSet!;
    root.dataset.theme = next;
    try { localStorage.setItem('ami-theme', next); } catch {}
    sync();
  }));
  media.addEventListener('change', sync);
  sync();

  // Sticky state. The header sits plain at the top while the hero's Apply
  // button is on screen; once that button scrolls out of view the header gains
  // a hairline and its own Apply button. Pages without a hero CTA start stuck.
  const top = document.querySelector<HTMLElement>('[data-top]');
  const cta = top?.querySelector<HTMLAnchorElement>('.top-cta');
  const hero = document.querySelector<HTMLElement>('[data-cta="hero"]');
  const setStuck = (on: boolean) => {
    top?.classList.toggle('is-stuck', on);
    if (cta) { cta.tabIndex = on ? 0 : -1; on ? cta.removeAttribute('aria-hidden') : cta.setAttribute('aria-hidden', 'true'); }
  };
  if (!hero || !('IntersectionObserver' in window)) setStuck(true);
  else new IntersectionObserver(([e]) => setStuck(!e.isIntersecting && e.boundingClientRect.top < 60), { rootMargin: '-60px 0px 0px 0px' }).observe(hero);
</script>
