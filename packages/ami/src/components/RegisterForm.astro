---
import { BASE } from '../config';
const industries = ['Financial services', 'Insurance', 'Healthcare and life sciences', 'Retail and consumer goods', 'Manufacturing and automotive', 'Technology and software', 'Telecom and media', 'Energy and utilities', 'Public sector', 'Other'];
const sizes = ['Under 1,000', '1,000 to 5,000', '5,000 to 20,000', '20,000 to 100,000', 'More than 100,000'];
---
<div class="reg" id="register">
  <form class="reg-form" novalidate>
    <div class="fields">
      <div class="f">
        <label for="f-name">Full name</label>
        <input id="f-name" name="name" type="text" autocomplete="name" required data-msg="Enter your full name." />
      </div>
      <div class="f">
        <label for="f-email">Work email</label>
        <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required data-msg="Enter your work email." />
      </div>
      <div class="f">
        <label for="f-company">Company</label>
        <input id="f-company" name="company" type="text" autocomplete="organization" required data-msg="Enter your company." />
      </div>
      <div class="f">
        <label for="f-title">Job title</label>
        <input id="f-title" name="title" type="text" autocomplete="organization-title" required data-msg="Enter your job title." />
      </div>
      <div class="f">
        <label for="f-size">Company size (employees)</label>
        <select id="f-size" name="company_size" required data-msg="Choose your company size.">
          <option value="">Choose one</option>
          {sizes.map((s) => <option>{s}</option>)}
        </select>
      </div>
      <div class="f">
        <label for="f-industry">Industry</label>
        <select id="f-industry" name="industry" required data-msg="Choose your industry.">
          <option value="">Choose one</option>
          {industries.map((s) => <option>{s}</option>)}
        </select>
      </div>
      <div class="f">
        <label for="f-agents">AI agents in production today</label>
        <select id="f-agents" name="agents_in_production" required data-msg="Choose how many agents you run.">
          <option value="">Choose one</option>
          <option>None yet</option>
          <option>1 to 5</option>
          <option>6 to 20</option>
          <option>More than 20</option>
        </select>
      </div>
      <div class="f">
        <label for="f-linkedin">LinkedIn <span class="opt">(optional)</span></label>
        <input id="f-linkedin" name="linkedin" type="url" inputmode="url" autocomplete="url" placeholder="linkedin.com/in/" />
      </div>
      <div class="hp" aria-hidden="true">
        <label for="f-website">Leave this empty</label>
        <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
    </div>

    <label class="check">
      <input type="checkbox" name="wants_sales_conversation" value="yes" />
      <span>Separately, I’d like to talk with SynOS about our agent program.</span>
    </label>

    <div class="submit-row">
      <div class="btns">
        <button class="btn btn-primary" type="submit" name="intent" value="cohort">Apply for the Founding Cohort</button>
        <button class="btn btn-ghost" type="submit" name="intent" value="report">Just send me the report</button>
      </div>
      <p class="consent">We use your details only for the Index, and never add you to a sales or marketing list. <a href={`${BASE}/privacy`}>Privacy</a></p>
    </div>
    <p class="status" role="status" aria-live="polite"></p>
    <noscript><p class="status is-err">This form needs JavaScript. Email index@getsynos.ai to apply.</p></noscript>
  </form>

  <div class="done" hidden tabindex="-1">
    <svg width="40" height="40" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 20.5l5.5 5.5L28.5 15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <h3 class="done-h">Thank you.</h3>
    <p class="done-p">We received your details.</p>
  </div>
</div>

<script>
  import { SITE } from '../config';
  import { api } from '../lib/api';
  const root = document.getElementById('register') as HTMLElement;
  const form = root.querySelector('form') as HTMLFormElement;
  const status = form.querySelector('.status') as HTMLElement;
  const done = root.querySelector('.done') as HTMLElement;
  const buttons = Array.from(form.querySelectorAll<HTMLButtonElement>('button[type=submit]'));
  let ctaLocation = '';

  type Intent = 'cohort' | 'report';
  const copy: Record<Intent, { h: string; p: string }> = {
    cohort: { h: 'Application received.', p: 'We review every application and reply within three business days, either to book your interview or to tell you if the cohort is not the right fit. You get the report either way.' },
    report: { h: 'You are on the list.', p: 'We will email the report the day it is published. That is the only email you will get from us.' },
  };
  const track = (event: string, props: Record<string, unknown> = {}) => {
    const w = window as unknown as { dataLayer?: unknown[] };
    const g = (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag;
    if (typeof g === 'function') g('event', event, props);
    else if (Array.isArray(w.dataLayer)) w.dataLayer.push({ event, ...props });
  };

  const ATTR = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'li_fat_id'];
  try {
    const q = new URLSearchParams(location.search);
    if (ATTR.some((k) => q.get(k))) {
      const a: Record<string, string> = {};
      ATTR.forEach((k) => { const v = q.get(k); if (v) a[k] = v; });
      sessionStorage.setItem('ami-attr', JSON.stringify(a));
    }
    if (!sessionStorage.getItem('ami-ref')) sessionStorage.setItem('ami-ref', document.referrer || 'direct');
  } catch {}

  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-cta]');
    if (!a) return;
    ctaLocation = a.dataset.cta || '';
    track('cta_click', { location: ctaLocation });
  });
  let started = false;
  form.addEventListener('focusin', () => { if (!started) { started = true; track('form_start'); } });

  const FREE = /@(?:gmail|googlemail|yahoo|ymail|hotmail|outlook|live|msn|icloud|me|mac|aol|proton(?:mail)?|pm|gmx|yandex|mail|zoho|hey|qq|163|126|web|fastmail|tutanota|tuta|zohomail|comcast|att|verizon)\.[a-z]{2,3}(?:\.[a-z]{2})?$/i;

  function err(el: HTMLInputElement | HTMLSelectElement, msg: string) {
    el.setAttribute('aria-invalid', 'true');
    let m = el.parentElement!.querySelector('.err') as HTMLElement | null;
    if (!m) { m = document.createElement('p'); m.className = 'err'; m.id = el.id + '-err'; el.parentElement!.appendChild(m); }
    m.textContent = msg;
    el.setAttribute('aria-describedby', m.id);
    track('form_error', { field: el.name });
  }
  function clear() {
    form.querySelectorAll('[aria-invalid]').forEach((el) => { el.removeAttribute('aria-invalid'); el.removeAttribute('aria-describedby'); });
    form.querySelectorAll('.err').forEach((m) => m.remove());
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitter = (e as SubmitEvent).submitter as HTMLButtonElement | null;
    const intent: Intent = submitter?.value === 'report' ? 'report' : 'cohort';
    clear();
    status.textContent = '';
    status.classList.remove('is-err');
    let first: HTMLElement | null = null;
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('.fields input[required], .fields select[required], #f-linkedin'));
    for (const f of fields) {
      const v = f.value.trim();
      if (f.required && !v) err(f, f.dataset.msg || 'Fill in this field.');
      else if (f.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) err(f, 'Enter an email address like name@company.com.');
      else if (f.type === 'email' && intent === 'cohort' && FREE.test(v)) err(f, 'Use your work email so we can confirm your company.');
      else if (f.id === 'f-linkedin' && v && !/linkedin\.com\//i.test(v)) err(f, 'Enter a LinkedIn profile link, or leave this empty.');
      else continue;
      first = first || f;
    }
    if (first) { first.focus(); return; }

    const fd = new FormData(form);
    if (fd.get('website')) return;
    fd.delete('website');
    const data: Record<string, unknown> = Object.fromEntries(fd.entries());
    data.type = intent;
    data.wants_sales_conversation = fd.get('wants_sales_conversation') === 'yes' ? 'yes' : 'no';
    data.self_assessment = Array.from(document.querySelectorAll<HTMLInputElement>('.selfscore input:checked')).map((i) => `${i.name}=${i.value}`).join(';');
    data.cta_location = ctaLocation;
    data.page = location.origin + location.pathname;
    try {
      Object.assign(data, JSON.parse(sessionStorage.getItem('ami-attr') || '{}'));
      data.referrer = sessionStorage.getItem('ami-ref') || '';
    } catch {}

    buttons.forEach((b) => (b.disabled = true));
    const label = submitter?.textContent || '';
    if (submitter) submitter.textContent = 'Sending…';
    try {
      await api('register', data);
      const c = copy[intent];
      (done.querySelector('.done-h') as HTMLElement).textContent = c.h;
      (done.querySelector('.done-p') as HTMLElement).textContent = c.p + (SITE.preview ? ' (Preview copy: nothing was sent.)' : '');
      form.hidden = true;
      done.hidden = false;
      done.focus();
      track('form_submit', { intent, agents: data.agents_in_production, size: data.company_size });
    } catch (x) {
      status.textContent = `${(x as Error).message} You can also email index@getsynos.ai.`;
      status.classList.add('is-err');
      buttons.forEach((b) => (b.disabled = false));
      if (submitter) { submitter.textContent = label; submitter.focus(); }
    }
  });
</script>

<style>
  .reg { background: var(--paper); border: 1px solid var(--line); border-radius: 20px; padding: clamp(22px, 3.6vw, 40px); }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 20px; }
  .f { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
  .f label { font-size: 14px; font-weight: 600; }
  .opt { font-weight: 400; color: var(--slate); }
  .f input, .f select {
    min-height: 50px; padding: 0 14px; border-radius: 12px;
    border: 1.5px solid var(--field); background: var(--paper); color: var(--ink);
    font: 400 17px/1.2 var(--font); width: 100%;
    transition: border-color .15s, box-shadow .15s;
  }
  .f input::placeholder { color: var(--slate); opacity: .7; }
  .f select { appearance: none; -webkit-appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--slate) 50%), linear-gradient(135deg, var(--slate) 50%, transparent 50%); background-position: calc(100% - 20px) 22px, calc(100% - 15px) 22px; background-size: 5px 5px; background-repeat: no-repeat; padding-right: 40px; }
  .f input:hover, .f select:hover { border-color: var(--slate); }
  .f input:focus, .f select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 24%, transparent); }
  .f [aria-invalid="true"] { border-color: var(--err); }
  .f :global(.err) { margin: 0; font-size: 14px; color: var(--err); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .check { display: flex; gap: 12px; align-items: flex-start; margin-top: 22px; font-size: 14px; color: var(--slate); cursor: pointer; min-height: 44px; }
  .check input { flex: none; width: 20px; height: 20px; margin: 1px 0 0; accent-color: var(--accent); }

  .submit-row { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; margin-top: 18px; }
  .btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn-ghost { border-color: var(--accent); color: var(--accent-ink); }
  .btn-ghost:hover { background: color-mix(in srgb, var(--accent) 8%, transparent); border-color: var(--accent); }
  .consent { margin: 0; font-size: 14px; color: var(--slate); max-width: 34em; }
  .status { margin: 16px 0 0; font-size: 15px; }
  .status:empty { display: none; }
  .status.is-err { color: var(--err); }
  .btn[disabled] { opacity: .6; cursor: progress; }

  .done { color: var(--ink); outline: none; }
  .done svg { color: var(--ok); margin-bottom: 16px; }
  .done h3 { font-size: 1.5rem; letter-spacing: -.02em; }
  .done p { margin: 8px 0 0; color: var(--slate); max-width: 34em; }

  @media (max-width: 720px) {
    .fields { grid-template-columns: 1fr; }
    .btns, .btns .btn { width: 100%; }
  }
</style>
