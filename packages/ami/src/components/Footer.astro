---
import { SITE, BASE } from '../config';
---
<footer class="foot">
  <div class="wrap foot-in">
    <div class="legal">
      <p>© 2026 {SITE.legalEntity}{SITE.legalEntity.endsWith('.') ? '' : '.'} Agent Maturity Index™ is a <a href={SITE.publisherUrl}>SynOS</a> research program.</p>
      <p class="fine">The framework (levels, dimensions and questions) is licensed under <a href={SITE.license.url} rel="license noopener" target="_blank">{SITE.license.name}</a>. Cite as: SynOS, <cite>Agent Maturity Index</cite>, 2026, getsynos.ai/agent-maturity-index. Benchmark data and reports are © {SITE.legalEntity}, all rights reserved; quote with attribution. Private benchmarks are confidential to the participant.</p>
    </div>
    <nav aria-label="Footer">
      <a href="/blog">Blog</a>
      <a href={`${BASE}/privacy`}>Privacy</a>
      <a href={SITE.termsUrl}>Terms</a>
      <a href={`mailto:${SITE.contactEmail}`}>Contact</a>
      <button type="button" class="linklike" data-cookie-settings>Cookie settings</button>
    </nav>
  </div>
</footer>

<style>
  .foot { padding: 20px 0 32px; border-top: 1px solid var(--line); font-size: 14px; color: var(--slate); }
  .foot-in { display: flex; flex-wrap: wrap; gap: 8px 32px; justify-content: space-between; align-items: center; }
  .foot p { margin: 0; padding: 12px 0; }
  .legal { max-width: 46em; }
  .legal .fine { padding-top: 0; font-size: 13px; line-height: 1.5; }
  .legal cite { font-style: italic; }
  .foot a, .linklike { color: var(--slate); }
  .foot nav { display: flex; gap: 0 20px; flex-wrap: wrap; }
  .foot nav a, .linklike { display: inline-flex; align-items: center; min-height: 44px; }
  .linklike { background: none; border: 0; padding: 0; font: inherit; text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
</style>
