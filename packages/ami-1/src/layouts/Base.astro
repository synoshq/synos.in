---
import { SITE, BASE } from '../config';
import CookieNotice from '../components/CookieNotice.astro';
import '@fontsource-variable/inter/opsz.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: object[];
  noindex?: boolean;
}
const { title, description, path = '/', jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(BASE + (path === '/' ? '' : path), Astro.site).href;
const ogImage = new URL(`${BASE}/og.png`, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="author" content={SITE.publisher} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href={`${BASE}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${BASE}/favicon.ico`} sizes="32x32" />
    <link rel="apple-touch-icon" href={`${BASE}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${BASE}/site.webmanifest`} />
    <link rel="sitemap" href={`${BASE}/sitemap-index.xml`} />
    <link rel="alternate" type="text/plain" href={`${BASE}/llms.txt`} title="LLM summary" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Agent Maturity Index: seven dimensions, five levels of enterprise AI agent maturity" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <CookieNotice />
  </body>
</html>
