---
import { SITE, BASE } from '../config';
---
<section id="cookie" class="cookie" aria-label="Cookie preferences" hidden
  data-analytics-src={SITE.analyticsSrc} data-analytics-domain={SITE.analyticsDomain}>
  <p>Optional analytics help us see what’s useful. Nothing loads unless you allow it. <a href={`${BASE}/privacy`}>Privacy</a></p>
  <div class="cookie-actions">
    <button type="button" class="cookie-btn" data-choice="declined">Decline</button>
    <button type="button" class="cookie-btn cookie-yes" data-choice="accepted">Allow</button>
  </div>
</section>

<script is:inline>
(function () {
  var KEY = 'ami-consent';
  var box = document.getElementById('cookie');
  var opener = null;
  function get() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
  function set(v) { try { localStorage.setItem(KEY, v); } catch (e) {} }
  function load() {
    var src = box.getAttribute('data-analytics-src');
    if (!src || document.getElementById('ami-analytics')) return;
    var s = document.createElement('script');
    s.id = 'ami-analytics'; s.defer = true; s.src = src;
    s.setAttribute('data-domain', box.getAttribute('data-analytics-domain') || '');
    document.head.appendChild(s);
  }
  function show(focus) {
    box.hidden = false;
    document.documentElement.classList.add('has-cookie');
    if (focus) box.querySelector('button').focus();
  }
  function hide() {
    var hadFocus = box.contains(document.activeElement);
    box.hidden = true;
    document.documentElement.classList.remove('has-cookie');
    if (opener) { opener.focus(); opener = null; }
    else if (hadFocus) { var m = document.getElementById('main'); if (m) { m.setAttribute('tabindex', '-1'); m.focus({ preventScroll: true }); } }
  }
  window.amiCookieSettings = function () { opener = document.activeElement; show(true); };
  document.addEventListener('click', function (e) {
    if (e.target.closest('[data-cookie-settings]')) window.amiCookieSettings();
  });

  var c = get();
  if (c === 'accepted') load();
  else if (!c) {
    // Ask on the visitor's first interaction, so the first view stays clean.
    var ev = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
    var once = function () { ev.forEach(function (n) { window.removeEventListener(n, once, true); }); show(false); };
    ev.forEach(function (n) { window.addEventListener(n, once, { capture: true, passive: true }); });
  }
  box.addEventListener('keydown', function (e) { if (e.key === 'Escape' && opener) hide(); });
  box.addEventListener('click', function (e) {
    var b = e.target.closest('[data-choice]');
    if (!b) return;
    var v = b.getAttribute('data-choice');
    set(v); hide();
    if (v === 'accepted') load();
  });
})();
</script>

<style>
  .cookie {
    position: fixed; z-index: 50;
    left: max(16px, env(safe-area-inset-left)); bottom: max(16px, env(safe-area-inset-bottom));
    width: min(400px, calc(100vw - 32px));
    padding: 14px 14px 14px 18px; border-radius: 16px;
    display: flex; align-items: center; gap: 14px;
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--line);
    box-shadow: 0 14px 36px -14px rgba(15, 27, 45, .3);
    font-size: 14px; line-height: 1.45;
  }
  .cookie[hidden] { display: none; }
  .cookie p { margin: 0; flex: 1; }
  .cookie-actions { display: flex; gap: 6px; flex: none; }
  .cookie-btn {
    min-height: 44px; padding: 0 14px; border-radius: 999px; cursor: pointer;
    font: 600 14px/1 var(--font); color: var(--ink);
    background: transparent; border: 1.5px solid var(--line);
  }
  .cookie-btn:hover { border-color: var(--ink); }
  .cookie-yes { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  @media (max-width: 560px) {
    .cookie { left: 10px; right: 10px; bottom: max(10px, env(safe-area-inset-bottom)); width: auto; padding: 10px 10px 10px 14px; gap: 10px; font-size: 13px; }
    .cookie p a { white-space: nowrap; }
  }
</style>
