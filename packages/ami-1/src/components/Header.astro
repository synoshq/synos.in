---
import { BASE } from '../config';
interface Props { cta?: boolean }
const { cta = true } = Astro.props;
---
<header class="top">
  <div class="wrap top-in">
    <a class="mark" href={BASE} aria-label="Agent Maturity Index home">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><rect x="1" y="14" width="4" height="7" rx="1" fill="currentColor" opacity=".35"/><rect x="9" y="8" width="4" height="13" rx="1" fill="currentColor" opacity=".65"/><rect x="17" y="1" width="4" height="20" rx="1" fill="currentColor"/></svg>
      <span>Agent Maturity Index</span>
    </a>
    <nav class="top-nav" aria-label="Main">
      {cta && <a class="top-cta" href={`${BASE}#join`} data-intent="cohort" data-cta="topnav">Apply</a>}
    </nav>
  </div>
</header>

<style>
  .top { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: color-mix(in srgb, var(--paper) 86%, transparent); backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px); }
  .top-in { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .mark { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--ink); text-decoration: none; font-weight: 650; font-size: 16px; letter-spacing: -.01em; }
  .mark svg { color: var(--accent); }
  .top-nav { display: flex; align-items: center; gap: 4px; }
  .top-nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; font-size: 15px; font-weight: 500; color: var(--slate); text-decoration: none; }
  .top-nav a:hover { color: var(--ink); }
  .top-nav .top-cta { font-weight: 600; color: var(--accent-ink); padding-right: 0; }
  @media (max-width: 400px) { .top-nav a:not(.top-cta) { padding: 0 8px; font-size: 14px; } }
  @media (max-width: 359px) { .top-nav a:not(.top-cta) { display: none; } }
</style>
