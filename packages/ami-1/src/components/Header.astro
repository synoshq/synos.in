---
import { BASE } from '../config';
interface Props { cta?: boolean }
const { cta = true } = Astro.props;
---
<header class="top">
  <div class="wrap top-in">
    <a class="mark" href={BASE} aria-label="Agent Maturity Index home">
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><rect x="1" y="14" width="4" height="7" rx="1" fill="currentColor" opacity=".35"/><rect x="9" y="8" width="4" height="13" rx="1" fill="currentColor" opacity=".65"/><rect x="17" y="1" width="4" height="20" rx="1" fill="currentColor"/></svg>
      <span>Agent Maturity Index</span>
    </a>
    <nav class="top-nav" aria-label="Main">
      <button class="theme" type="button" aria-label="Dark mode" aria-pressed="false" title="Switch to dark mode">
        <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></g></svg>
      </button>
      {cta && <a class="top-cta" href={`${BASE}#join`} data-intent="cohort" data-cta="topnav">Apply</a>}
    </nav>
  </div>
</header>

<style>
  .top { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: color-mix(in srgb, var(--paper) 86%, transparent); backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px); }
  .top-in { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .mark { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; color: var(--ink); text-decoration: none; font-weight: 650; font-size: 16px; letter-spacing: -.01em; }
  .mark svg { color: var(--accent); }
  .top-nav { display: flex; align-items: center; gap: 4px; }
  .top-nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; font-size: 15px; font-weight: 500; color: var(--slate); text-decoration: none; }
  .top-nav a:hover { color: var(--ink); }
  .top-nav .top-cta { font-weight: 600; color: var(--accent-ink); padding-right: 0; }
  .theme { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 50%; background: none; color: var(--slate); cursor: pointer; }
  .theme:hover { color: var(--ink); }
  .theme:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theme .i-sun { display: none; }
  .theme[aria-pressed="true"] .i-sun { display: block; }
  .theme[aria-pressed="true"] .i-moon { display: none; }
  @media (max-width: 400px) { .top-nav a:not(.top-cta) { padding: 0 8px; font-size: 14px; } }
  @media (max-width: 359px) { .top-nav a:not(.top-cta) { display: none; } }
</style>

<script>
  // Light/dark toggle. Starts from the device setting; a click pins the other
  // theme on <html data-theme> and remembers it for the next visit.
  const btn = document.querySelector<HTMLButtonElement>('.top .theme');
  const root = document.documentElement;
  const media = matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.dataset.theme || (media.matches ? 'dark' : 'light')) === 'dark';
  const sync = () => {
    if (!btn) return;
    const dark = isDark();
    btn.setAttribute('aria-pressed', String(dark));
    btn.title = dark ? 'Switch to light mode' : 'Switch to dark mode';
  };
  btn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('ami-theme', next); } catch {}
    sync();
  });
  media.addEventListener('change', sync);
  sync();
</script>
